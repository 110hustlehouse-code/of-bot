{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "background/**/*.ts",
    "content/**/*.ts",
    "popup/**/*.ts",
    "sidebar/**/*.ts",
    "utils/**/*.ts"
  ]
}
