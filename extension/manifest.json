{
  "manifest_version": 3,
  "name": "Aura",
  "version": "1.0.0",
  "description": "AI chat automation for OnlyFans",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://onlyfans.com/*", "https://api.aurafullsuite.it/*"],
  "content_scripts": [
    {
      "matches": ["https://onlyfans.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
